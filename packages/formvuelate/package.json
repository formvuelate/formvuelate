{
  "name": "formvuelate",
  "version": "4.1.0",
  "description": "Schema Form Generator",
  "author": "Marina Mosti",
  "license": "MIT",
  "type": "module",
  "main": "dist/formvuelate.cjs.js",
  "module": "dist/formvuelate.es.js",
  "types": "dist/formvuelate.d.ts",
  "exports": {
    ".": {
      "types": "./dist/formvuelate.d.ts",
      "import": "./dist/formvuelate.es.js",
      "require": "./dist/formvuelate.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "cypress open --component",
    "test:e2e:ci": "cypress run --component",
    "lint": "eslint . --fix",
    "test": "pnpm lint && pnpm test:unit"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "homepage": "https://formvuelate.js.org/",
  "keywords": [
    "vue",
    "form",
    "schema",
    "plugin",
    "dynamic form"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formvuelate/formvuelate.git",
    "directory": "packages/formvuelate"
  },
  "bugs": {
    "url": "https://github.com/formvuelate/formvuelate/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
