{
  "name": "formvuelate-monorepo",
  "description": "Schema Form Generator",
  "author": "Marina Mosti",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r --filter=\"./packages/*\" run build",
    "test": "pnpm lint && pnpm test:unit",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "cypress open --component",
    "test:e2e:ci": "cypress run --component",
    "lint": "eslint . --fix",
    "ci:lint": "eslint .",
    "format": "prettier --write .",
    "docs:dev": "pnpm --filter=\"./docs/4.x\" run dev",
    "docs:build": "pnpm --filter=\"./docs/4.x\" run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/compiler-sfc": "^3.5.12",
    "@vue/test-utils": "^2.4.6",
    "cypress": "^15.15.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-cypress": "^4.0.0",
    "eslint-plugin-n": "^17.13.1",
    "eslint-plugin-vue": "^9.30.0",
    "flush-promises": "^1.0.2",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "rollup-plugin-dts": "^6.1.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.2",
    "vee-validate": "^4.14.6",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.1.7",
    "vue": "^3.5.12",
    "yup": "^1.4.0"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "bugs": {
    "url": "https://github.com/formvuelate/formvuelate/issues"
  },
  "contributors": [
    {
      "name": "Marina Mosti"
    }
  ]
}
